{
  "manifest_version": 3,
  "name": "Lean ChatGPT Bridge",
  "version": "1.8.0",
  "description": "Local bridge between Python and ChatGPT; prioritizes the current assistant body DOM marker.",
  "permissions": [],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Lean ChatGPT Bridge",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
